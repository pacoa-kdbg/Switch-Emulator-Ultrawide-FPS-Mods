# Pokémon Sword [0100ABF008968000] v1.3.2 - 4:3 + UI candidate C
# Iteration 2. Middle bracket between candidate A (16:9) and candidate B (4:3).
# HUD aspect double = 1.5 (0x3FF8000000000000, exact 3:2).
# Try this if B under-corrects or A over-corrects icon scale.
#
#   movk x9, #0x0000, lsl #32 -> raw 0xF2C00009 -> LE 0900C0F2
#   movk x9, #0x3FF8, lsl #48 -> raw 0xF2E7FF09 -> LE 09FFE7F2

@flag print_values
@flag offset_shift 0x100

@enabled
00d93414 2C03A8F2 // Culling (unchanged)
00607de8 0900C0F2 // Aspect double [63:32] low16 -> 0x0000  (UI aspect = 1.5 dbl)
00607dec 09FFE7F2 // Aspect double [63:32] high16 -> 0x3FF8 (UI aspect = 1.5 dbl)
006076c4 e8ffff17 // Camera distortion (unchanged)
00607664 69559552 // World aspect float low16 = 0xAAAB (4:3f)
00607668 49F5A772 // World aspect float high16 = 0x3FAA (4:3f)
0060766c 17000014 // Camera distortion (unchanged)
@stop

