@nsobid-A3B75BCD3311385AEED67FBEEB79CBB7BF02F471

# Pokémon Sword [0100ABF008968000] v1.3.2 - 4:3 + UI candidate B
# Iteration 2. Candidate A pinned the aspect double at 0x00607de8 to 16:9;
# text rendered fine, but menu icons were misaligned/mis-scaled.
# Hypothesis: the double is used as a pre-stretch X-scale for sprite quads.
# Pinning it to 4:3 (matching the output window) should keep icon sprites
# at their designed proportions. If text was OK at 16:9, text likely uses
# a different constant path and should stay OK.
#
# Aspect double target = 4:3 double = 0x3FF5555555555555
#   top32 = 0x3FF55555 (low32 stays 0 from prior movz, so effective double
#   = 0x3FF5555500000000 = 1.3333282..., close enough to 4:3 for layout).
#   movk x9, #0x5555, lsl #32 -> raw 0xF2CAAAA9 -> LE A9AACAF2
#   movk x9, #0x3FF5, lsl #48 -> raw 0xF2E7FEA9 -> LE A9FEE7F2

@flag print_values
@flag offset_shift 0x100

@enabled
00d93414 2C03A8F2 // Culling (unchanged)
00607de8 A9AACAF2 // Aspect double [63:32] low16 -> 0x5555  (UI aspect = 4:3 dbl)
00607dec A9FEE7F2 // Aspect double [63:32] high16 -> 0x3FF5 (UI aspect = 4:3 dbl)
006076c4 e8ffff17 // Camera distortion (unchanged)
00607664 69559552 // World aspect float low16 = 0xAAAB (4:3f)
00607668 49F5A772 // World aspect float high16 = 0x3FAA (4:3f)
0060766c 17000014 // Camera distortion (unchanged)
@stop

@pacoa-kdbg (derived from Fl4sh_#9174 21:9 mod)
https://github.com/pacoa-kdbg/Switch-Emulator-Ultrawide-FPS-Mods
