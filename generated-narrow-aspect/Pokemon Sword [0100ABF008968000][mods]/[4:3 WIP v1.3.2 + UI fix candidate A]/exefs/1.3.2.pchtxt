@nsobid-A3B75BCD3311385AEED67FBEEB79CBB7BF02F471

# Pokémon Sword [0100ABF008968000] v1.3.2 - 4:3 + UI pillarbox (candidate A)
# World projection stays at 4:3 (from base 4:3 WIP mod);
# the untouched aspect double at 0x00607de8/0x00607dec is forced to 16:9
# on the theory that it drives HUD/menu layout. If the HUD stops stretching
# horizontally (menus/backgrounds fit ~16:9 pillar-boxed inside the 4:3 window),
# we have identified the UI aspect site.
#
# Base line values from [4:3 WIP v1.3.2]/1.3.2.pchtxt are preserved.
# New: 0x00607de8/0x00607dec re-encoded from double 2.388  -> double 16:9.
#   movk x9, #0x71C7, lsl #32   -> raw 0xF2CE38E9 -> E938CEF2
#   movk x9, #0x3FFC, lsl #48   -> raw 0xF2E7FF89 -> 89FFE7F2

@flag print_values
@flag offset_shift 0x100

@enabled
00d93414 2C03A8F2 // Culling (unchanged)
00607de8 E938CEF2 // Aspect double [63:32] low16 -> 0x71C7  (UI aspect = 16:9 dbl)
00607dec 89FFE7F2 // Aspect double [63:32] high16 -> 0x3FFC (UI aspect = 16:9 dbl)
006076c4 e8ffff17 // Camera distortion (unchanged)
00607664 69559552 // World aspect float low16 = 0xAAAB (4:3f)
00607668 49F5A772 // World aspect float high16 = 0x3FAA (4:3f)
0060766c 17000014 // Camera distortion (unchanged)
@stop

@pacoa-kdbg (derived from Fl4sh_#9174 21:9 mod)
https://github.com/pacoa-kdbg/Switch-Emulator-Ultrawide-FPS-Mods
